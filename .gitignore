# ============================================
# WorkFlow Manager - .gitignore
# ============================================

# ---- Node.js / Server ----
node_modules/
server/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ---- Environment Variables ----
.env
.env.local
.env.development
.env.production
server/.env

# ---- Build Outputs ----
dist/
build/
out/

# ---- Uploads (user-generated content) ----
server/uploads/
uploads/

# ---- Logs ----
logs/
*.log

# ---- OS Files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Testing ----
coverage/
.nyc_output/

# ---- Misc ----
*.tmp
*.bak
*.orig